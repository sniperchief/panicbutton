# Copy to .env (git-ignored) and fill in. Never commit .env.

# Required. 32 random bytes as 64 hex chars; encrypts the per-session bot keys at rest.
# Generate on your machine (see README); losing it makes stored bot keys unusable.
KEYSTORE_KEY=

# Off unless exactly "true". When off, prepare + simulate work and nothing is ever sent.
EXECUTION_ENABLED=false

# Slippage limits in bps. The server rejects anything above MAX_SLIPPAGE_BPS (hard cap 300).
DEFAULT_SLIPPAGE_BPS=50
MAX_SLIPPAGE_BPS=300

HOST=127.0.0.1
PORT=8787
DATA_DIR=.data
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# Optional. Telegram bot token from @BotFather. Unset = no bot. Secret: never commit,
# paste into chats or logs. The bot long-polls Telegram; no public URL is needed.
TELEGRAM_BOT_TOKEN=
