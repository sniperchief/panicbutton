{
  "name": "panicbutton",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@hono/node-server": "1.19.14",
    "@somnia-chain/markets-sdk": "0.32.1",
    "hono": "4.6.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.38.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "5.4.11",
    "vitest": "3.2.4"
  }
}
